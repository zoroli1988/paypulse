{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "paypulse",
  "version": "0.1.6",
  "identifier": "com.bydota.paypulse",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hud",
        "title": "牛马薪动了！",
        "width": 302,
        "height": 258,
        "minWidth": 302,
        "minHeight": 160,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "BYDOTA",
    "copyright": "Copyright © 2026 BYDOTA",
    "category": "Productivity",
    "shortDescription": "实时薪资悬浮窗",
    "longDescription": "把月薪摊成每一秒：金额每帧重算、绝不累加；双账隔离，计入月薪的和只记白干的永远分开。",
    "licenseFile": "../LICENSE",
  "resources": {
    "../THIRD-PARTY.md": "THIRD-PARTY.md"
  },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
